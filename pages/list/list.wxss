/* 顶部主视觉：纯 CSS 渐变 + 伪元素模拟远山近水，零图片资源 */
.hero {
  position: relative;
  padding: 56rpx 36rpx 44rpx;
  background: linear-gradient(160deg, #17503f 0%, #2e8b6f 52%, #57b096 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.hero::after {
  content: "";
  position: absolute;
  left: -50rpx;
  bottom: -70rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-title {
  position: relative;
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 6rpx;
}

.hero-sub {
  position: relative;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 2rpx;
}

.hero-badge {
  position: relative;
  display: inline-block;
  margin-top: 22rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.spot-list {
  padding: 28rpx 24rpx 40rpx;
}

/* 列表卡片。
   注意：这里只用 background-color（不用 background 简写），
   否则会覆盖掉 wxml 内联 style 里那条「进度条」背景渐变。 */
.item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 0 28rpx 34rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 80, 63, 0.08);
  overflow: hidden;
}

.item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 26rpx;
  bottom: 26rpx;
  width: 8rpx;
  background: #2e8b6f;
  border-radius: 0 8rpx 8rpx 0;
  z-index: 2;
}

/* 卡片顶部封面图：固定高度 + 裁剪填满。 */
.item .cover {
  display: block;
  width: calc(100% + 56rpx);
  height: 220rpx;
  margin: 0 -28rpx 24rpx;
  background: #eef3f0;
}

.item .name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1b2b26;
  letter-spacing: 2rpx;
}

.item .meta {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #2e8b6f;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-tip {
  padding: 140rpx 0;
  text-align: center;
}

.empty-ill {
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 65%, #cfe2da 0%, #eef3f0 62%, #f5f8f6 100%);
}

.empty-text {
  font-size: 30rpx;
  color: #9aa6a2;
  letter-spacing: 2rpx;
}

/* ===== 折叠屏 / 平板等宽屏适配 =====
   app.json 开启 resizable 后，大屏设备会给小程序更宽的绘制区，
   rpx 随绘制区宽度等比放大。这里做两件事：
   1) 容器保持铺满（不额外留白），但左右边距适度加大，避免卡片过宽、文字行过长；
   2) 收敛字号与封面图高度，避免元素被拉伸得过大。
   断点 680px：普通手机（≤480px）不触发，折叠屏展开 / 平板触发。 */
@media (min-width: 680px) {
  .hero {
    padding: 48rpx 64rpx 40rpx;
  }

  .hero-title {
    font-size: 42rpx;
  }

  .hero-sub {
    font-size: 22rpx;
  }

  .hero-badge {
    font-size: 19rpx;
  }

  .spot-list {
    padding: 32rpx 56rpx 56rpx;
  }

  .item {
    margin-bottom: 28rpx;
  }

  .item .cover {
    height: 200rpx;
  }

  .item .name {
    font-size: 33rpx;
  }

  .item .meta {
    font-size: 21rpx;
  }
}
