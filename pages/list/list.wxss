/* 顶部主视觉：纯 CSS 渐变 + 伪元素模拟远山近水，零图片资源 */
.hero {
  position: relative;
  padding: 56rpx 36rpx 44rpx;
  background: linear-gradient(160deg, #17503f 0%, #2e8b6f 52%, #57b096 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.hero::after {
  content: "";
  position: absolute;
  left: -50rpx;
  bottom: -70rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-title {
  position: relative;
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 6rpx;
}

.hero-sub {
  position: relative;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 2rpx;
}

.hero-badge {
  position: relative;
  display: inline-block;
  margin-top: 22rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.spot-list {
  padding: 28rpx 24rpx 40rpx;
}

/* 列表卡片。
   注意：这里只用 background-color（不用 background 简写），
   否则会覆盖掉 wxml 内联 style 里那条「进度条」背景渐变。 */
.item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 0 28rpx 34rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 80, 63, 0.08);
  overflow: hidden;
}

.item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 26rpx;
  bottom: 26rpx;
  width: 8rpx;
  background: #2e8b6f;
  border-radius: 0 8rpx 8rpx 0;
  z-index: 2;
}

/* 卡片顶部封面图：固定高度 + 裁剪填满。 */
.item .cover {
  display: block;
  width: calc(100% + 56rpx);
  height: 220rpx;
  margin: 0 -28rpx 24rpx;
  background: #eef3f0;
}

.item .name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1b2b26;
  letter-spacing: 2rpx;
}

.item .meta {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #2e8b6f;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-tip {
  padding: 140rpx 0;
  text-align: center;
}

.empty-ill {
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 65%, #cfe2da 0%, #eef3f0 62%, #f5f8f6 100%);
}

.empty-text {
  font-size: 30rpx;
  color: #9aa6a2;
  letter-spacing: 2rpx;
}

/* 宽屏适配（折叠屏展开 / 平板 / 桌面端）。
   rpx 会随屏幕宽度等比放大，宽屏下元素会被整体撑大；
   这里改用固定 px 收敛尺寸，并把列表改为两列，
   让多出来的横向空间变成信息密度，而不是把元素等比放大。 */
@media (min-width: 520px) {
  .hero {
    padding: 34px 28px 26px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
  }

  .hero::before {
    right: -40px;
    bottom: -60px;
    width: 200px;
    height: 200px;
  }

  .hero::after {
    left: -30px;
    bottom: -45px;
    width: 150px;
    height: 150px;
  }

  .hero-title {
    font-size: 30px;
    letter-spacing: 3px;
  }

  .hero-sub {
    margin-top: 8px;
    font-size: 14px;
    letter-spacing: 1px;
  }

  .hero-badge {
    margin-top: 14px;
    padding: 5px 14px;
    font-size: 12px;
  }

  /* 两列排布：卡片宽度固定为半屏减间隙，奇数个时最后一张自然靠左 */
  .spot-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 18px 18px 26px;
  }

  .item {
    width: calc(50% - 8px);
    margin-bottom: 16px;
    padding: 0 18px 20px;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(23, 80, 63, 0.08);
  }

  .item::before {
    top: 16px;
    bottom: 16px;
    width: 5px;
    border-radius: 0 5px 5px 0;
  }

  .item .cover {
    width: calc(100% + 36px);
    height: 150px;
    margin: 0 -18px 14px;
  }

  .item .name {
    font-size: 20px;
    letter-spacing: 1px;
  }

  .item .meta {
    margin-top: 10px;
    font-size: 13px;
  }

  .empty-tip {
    padding: 90px 0;
  }

  .empty-ill {
    width: 110px;
    height: 110px;
    margin-bottom: 22px;
  }

  .empty-text {
    font-size: 16px;
    letter-spacing: 1px;
  }
}
