.spot {
  padding: 0 0 40rpx;
}

/* 顶栏 */
.spot-head {
  padding: 40rpx 36rpx 24rpx;
  background: linear-gradient(160deg, #17503f 0%, #2e8b6f 100%);
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.spot-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* 目录圆点：默认灰、当前青绿、已打卡带朱砂角标 */
.dots {
  display: flex;
  margin-top: 28rpx;
}

.dot {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  margin-right: 18rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a9b95;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 50%;
}

.dot.is-current {
  color: #ffffff;
  background: #ffffff;
  color: #1b5e4b;
  font-weight: 600;
}

.dot.is-visited::after {
  content: "";
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  width: 16rpx;
  height: 16rpx;
  background: #c8452f;
  border-radius: 50%;
}

/* 景区简介 */
.intro {
  margin: 28rpx 28rpx 0;
  padding: 24rpx 26rpx;
  background: #eef4f1;
  border-left: 6rpx solid #2e8b6f;
  border-radius: 12rpx;
}

.intro-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #5c6f68;
  text-align: justify;
}

/* 内容卡片 */
.spot-card {
  position: relative;
  margin: 32rpx 28rpx 0;
  padding: 40rpx 32rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 80, 63, 0.08);
  overflow: hidden;
}

.card-bar {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 8rpx;
  background: linear-gradient(to right, #2e8b6f 0%, #57b096 100%);
}

.spot-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b2b26;
  letter-spacing: 3rpx;
}

.spot-body {
  margin-top: 24rpx;
}

.body-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: #4a5c56;
  text-align: justify;
}

/* 打卡 */
.visit {
  margin-top: 36rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #2e8b6f;
  background: #eaf3ef;
  border-radius: 999rpx;
}

.visit.is-visited {
  color: #ffffff;
  background: #c8452f;
}

/* 翻页 */
.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 28rpx 0;
}

.nav-btn {
  padding: 22rpx 44rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2e8b6f;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(46, 139, 111, 0.25);
}

.nav-btn.is-disabled {
  color: #a9b5b1;
  background: #e6ebe9;
  box-shadow: none;
}

.pager-state {
  font-size: 26rpx;
  color: #7c8a86;
  letter-spacing: 2rpx;
}

/* 宽屏适配（折叠屏展开 / 平板 / 桌面端）：
   固定 px 收敛尺寸；正文改用双栏，避免宽屏下单行文字过长影响阅读。 */
@media (min-width: 520px) {
  .spot {
    padding: 0 0 26px;
  }

  .spot-head {
    padding: 22px 26px 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
  }

  .spot-title {
    font-size: 24px;
    letter-spacing: 2px;
  }

  .dots {
    margin-top: 16px;
  }

  .dot {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    line-height: 34px;
    font-size: 14px;
  }

  .dot.is-visited::after {
    width: 10px;
    height: 10px;
  }

  .intro {
    margin: 16px 18px 0;
    padding: 14px 16px;
    border-left-width: 4px;
    border-radius: 8px;
  }

  .intro-text {
    font-size: 14px;
    line-height: 1.75;
  }

  .spot-card {
    margin: 18px 18px 0;
    padding: 22px 20px 18px;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(23, 80, 63, 0.08);
  }

  .card-bar {
    height: 5px;
  }

  .spot-name {
    font-size: 22px;
    letter-spacing: 2px;
  }

  .spot-body {
    margin-top: 14px;
  }

  .body-text {
    font-size: 15px;
    line-height: 1.9;
    -webkit-column-count: 2;
    column-count: 2;
    -webkit-column-gap: 32px;
    column-gap: 32px;
  }

  .visit {
    margin-top: 20px;
    padding: 12px 0;
    font-size: 16px;
  }

  .pager {
    margin: 20px 18px 0;
  }

  .nav-btn {
    padding: 12px 26px;
    font-size: 16px;
  }

  .pager-state {
    font-size: 15px;
  }
}
